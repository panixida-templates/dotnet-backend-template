using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Http;

namespace {{ model.module }}.Presentation.Features.{{ model.feature }}.Write.Update;

internal sealed class Update{{ model.resource }}Endpoint : IEndpoint<{{ model.feature }}Endpoints>
{
