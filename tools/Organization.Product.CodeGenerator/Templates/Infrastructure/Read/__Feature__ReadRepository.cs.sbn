        return {{ model.resource }}DetailsReadModelMapper.ProjectTo(query).FirstOrDefaultAsync(cancellationToken);
{{ else }}        return GetByIdAsync<{{ model.resource }}DetailsReadModel, {{ model.resource }}DetailsReadModelMapper>(
