            cancellationToken);
{{ end }}    }

    public {{ if model.child }}async {{ end }}Task<PaginationResult<{{ model.resource }}ListItemReadModel>{{ if model.child }}?{{ end }}> GetPagedListAsync(
{{ if model.child }}        Guid parentId,
{{ end }}        PaginationParameters paginationParameters,
