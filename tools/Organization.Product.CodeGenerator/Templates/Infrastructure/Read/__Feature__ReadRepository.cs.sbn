public sealed class {{ model.feature }}ReadRepository({{ model.module_name }}ReadDbContext dbContext) :
    EfReadRepository<{{ model.module_name }}ReadDbContext, Guid, {{ model.resource }}ReadDbModel>(dbContext),
    I{{ model.feature }}ReadRepository
{
{{ if model.child }}    private readonly IQueryable<{{ model.child.parent_resource }}ReadDbModel> _parents =
        dbContext.Set<{{ model.child.parent_resource }}ReadDbModel>();

{{ end }}    public Task<{{ model.resource }}DetailsReadModel?> GetByIdAsync(
{{ if model.child }}        Guid parentId,
{{ end }}        Guid id,
        CancellationToken cancellationToken)
    {
{{ if model.child }}        var query = Query
